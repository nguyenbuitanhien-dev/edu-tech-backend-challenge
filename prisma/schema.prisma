// Prisma Schema Definition for Education & Tech Service Management System (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum RoleEnum {
  STUDENT
  STAFF
  MANAGER
  TEACHER
}

enum PaymentTypeEnum {
  MONTHLY
  FULL_COURSE
}

enum EnrollmentStatusEnum {
  REGISTERED
  CONSULTED
  PAID
  FINISHED
}

enum PaymentStatusEnum {
  PENDING
  PAID
  OVERDUE
}

enum AttendanceStatusEnum {
  PRESENT
  ABSENT
  LATE
}

enum ServiceRequestStatusEnum {
  NEW
  IN_PROGRESS
  DONE
  CANCELED
}

// ------------------------------------------------------
// Models
// ------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         RoleEnum @default(STUDENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  teacherClasses     Class[]             @relation("TeacherClasses")
  staffClasses       Class[]             @relation("StaffClasses")
  enrollments        Enrollment[]
  customerRequests   ServiceRequest[]    @relation("CustomerRequests")
  staffRequests      ServiceRequest[]    @relation("StaffRequests")
  serviceRequestLogs ServiceRequestLog[] @relation("ChangedByLogs")

  @@map("users")
}

model Course {
  id          String          @id @default(uuid())
  name        String
  description String?
  courseCode  String          @unique @map("course_code")
  paymentType PaymentTypeEnum @map("payment_type")
  bookSet     String?         @map("book_set")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relations
  classes Class[]

  @@map("courses")
}

model Class {
  id             String   @id @default(uuid())
  courseId       String   @map("course_id")
  classCode      String   @unique @map("class_code")
  startDate      String   @map("start_date") // YYYY-MM-DD
  endDate        String   @map("end_date")   // YYYY-MM-DD
  googleMeetLink String?  @map("google_meet_link")
  teacherId      String   @map("teacher_id")
  staffId        String   @map("staff_id")
  capacity       Int      @default(30)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     User              @relation("TeacherClasses", fields: [teacherId], references: [id])
  staff       User              @relation("StaffClasses", fields: [staffId], references: [id])
  sessions    ScheduleSession[]
  enrollments Enrollment[]

  @@map("classes")
}

model ScheduleSession {
  id          String   @id @default(uuid())
  classId     String   @map("class_id")
  sessionDate String   @map("session_date") // YYYY-MM-DD
  startTime   String   @map("start_time")   // HH:mm
  endTime     String   @map("end_time")     // HH:mm
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@map("schedule_sessions")
}

model Enrollment {
  id           String               @id @default(uuid())
  studentId    String               @map("student_id")
  classId      String               @map("class_id")
  status       EnrollmentStatusEnum @default(REGISTERED)
  accessLocked Boolean              @default(false) @map("access_locked")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  // Relations
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  payments    Payment[]
  attendances Attendance[]

  @@map("enrollments")
}

model Payment {
  id           String            @id @default(uuid())
  enrollmentId String            @map("enrollment_id")
  amount       Int
  dueDate      String            @map("due_date")  // YYYY-MM-DD
  paidDate     String?           @map("paid_date") // YYYY-MM-DD
  status       PaymentStatusEnum @default(PENDING)
  monthIndex   Int?              @map("month_index") // null cho FULL_COURSE, 1..3 cho MONTHLY
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Attendance {
  id           String               @id @default(uuid())
  enrollmentId String               @map("enrollment_id")
  sessionId    String               @map("session_id")
  status       AttendanceStatusEnum @default(PRESENT)
  createdAt    DateTime             @default(now()) @map("created_at")

  // Relations
  enrollment Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  session    ScheduleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

model ServiceRequest {
  id              String                   @id @default(uuid())
  customerId      String?                  @map("customer_id")
  staffId         String?                  @map("staff_id")
  serviceName     String                   @map("service_name")
  contactInfo     String                   @map("contact_info")
  status          ServiceRequestStatusEnum @default(NEW)
  rating          Int?
  feedbackComment String?                  @map("feedback_comment")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  // Relations
  customer User?               @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: SetNull)
  staff    User?               @relation("StaffRequests", fields: [staffId], references: [id], onDelete: SetNull)
  logs     ServiceRequestLog[]

  @@map("service_requests")
}

model ServiceRequestLog {
  id               String                    @id @default(uuid())
  serviceRequestId String                    @map("service_request_id")
  oldStatus        ServiceRequestStatusEnum? @map("old_status")
  newStatus        ServiceRequestStatusEnum  @map("new_status")
  changedById      String                    @map("changed_by_id")
  changedAt        DateTime                  @default(now()) @map("changed_at")

  // Relations
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  changedBy      User           @relation("ChangedByLogs", fields: [changedById], references: [id], onDelete: Cascade)

  @@map("service_request_logs")
}
